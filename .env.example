# Local-development tokens only; never commit .env or expose this mode publicly.
# Generate one unique high-entropy value per configured agent ID.
# VORTEX_AGENT_IDS=hermes-1,hermes-2,antigravity-1,spark-1
VORTEX_TOKEN_HERMES_1=
VORTEX_TOKEN_HERMES_2=
VORTEX_TOKEN_ANTIGRAVITY_1=
VORTEX_TOKEN_SPARK_1=
# Operator identities get fleet-wide oversight (vortex_operator_* tools).
# Each must also appear in VORTEX_AGENT_IDS with its own token. Empty = no operators.
# VORTEX_AGENT_IDS=hermes-1,hermes-2,antigravity-1,spark-1,claude-operator
# VORTEX_TOKEN_CLAUDE_OPERATOR=
# VORTEX_OPERATOR_IDS=claude-operator
# Approval gate: matching tasks start pending and cannot be claimed until an operator approves.
# '*' gates every task; agent IDs gate tasks assigned to them. Requires an operator. Empty = off.
# Any creator can also opt a single task in with requires_approval=true.
# VORTEX_APPROVAL_REQUIRED_FOR=hermes-2
VORTEX_DATA_DIR=.vortex-data
VORTEX_HOST=127.0.0.1
VORTEX_PORT=8000

# --- Watcher (python -m vortex.watcher); alerts only on changes ---
# VORTEX_URL=http://127.0.0.1:8000/mcp
# VORTEX_OPERATOR_TOKEN=          # same value as the operator's VORTEX_TOKEN_<ID>
# VORTEX_WATCH_INTERVAL=60
# VORTEX_ALERT_NTFY_TOPIC=        # phone push via the ntfy app (pick an unguessable topic)
# VORTEX_ALERT_NTFY_SERVER=https://ntfy.sh
# VORTEX_ALERT_WEBHOOK=           # Slack/Discord-style incoming webhook
# VORTEX_ALERT_COMMAND=           # run per alert batch (no shell); text in $VORTEX_ALERT_TEXT and stdin

# --- API key mode (VORTEX_AUTH_MODE=apikey) ---
# One revocable key per agent, stored only as a hash in Postgres. Issue with: python -m vortex keys add <agent>
#VORTEX_AUTH_MODE=apikey
#VORTEX_PUBLIC_URL=https://vortex.example.com
#VORTEX_ALLOWED_HOSTS=vortex.example.com
#VORTEX_ALLOWED_ORIGINS=https://vortex.example.com
#VORTEX_STORE_URL=            # required in this mode: a postgresql:// connection string (never commit it)
#VORTEX_SCHEMA=forge

# --- OAuth 2.1 mode (VORTEX_AUTH_MODE=oauth) ---
# All fields below are required when oauth mode is selected; startup fails closed otherwise.
#VORTEX_AUTH_MODE=oauth
# Public HTTPS URL clients use to reach this server. Sets the OAuth audience
# and the MCP resource_url, so it must match exactly (no trailing slash).
#VORTEX_PUBLIC_URL=https://vortex.example.com
# Host/Origin are matched exactly including the port, or via a :* wildcard.
#VORTEX_ALLOWED_HOSTS=vortex.example.com
#VORTEX_ALLOWED_ORIGINS=https://vortex.example.com
#VORTEX_OAUTH_ISSUER=https://id.example.com/realms/vortex
#VORTEX_OAUTH_INTROSPECTION_URL=https://id.example.com/realms/vortex/protocol/openid-connect/token/introspect
#VORTEX_OAUTH_CLIENT_ID=vortex-introspection
#VORTEX_OAUTH_CLIENT_SECRET=
# Keycloak client id per Vortex identity (token's client becomes the identity).
#VORTEX_CLIENT_HERMES_1=hermes-1
#VORTEX_CLIENT_HERMES_2=hermes-2
#VORTEX_CLIENT_ANTIGRAVITY_1=antigravity-1
#VORTEX_CLIENT_SPARK_1=spark-1
# Legacy variable names are still accepted: VORTEX_SUBJECT_<AGENT>.
# Optional PEM bundle for an internal/Tailscale-signed provider certificate.
#VORTEX_OAUTH_CA_BUNDLE=/path/to/ca.pem
