# Local-development tokens only; never commit .env or expose this mode publicly.
# Generate one unique high-entropy value per configured agent ID.
# VORTEX_AGENT_IDS=hermes-1,hermes-2,antigravity-1,spark-1
VORTEX_TOKEN_HERMES_1=
VORTEX_TOKEN_HERMES_2=
VORTEX_TOKEN_ANTIGRAVITY_1=
VORTEX_TOKEN_SPARK_1=
VORTEX_DATA_DIR=.vortex-data
VORTEX_HOST=127.0.0.1
VORTEX_PORT=8000

# --- OAuth 2.1 mode (VORTEX_AUTH_MODE=oauth) ---
# All fields below are required when oauth mode is selected; startup fails closed otherwise.
#VORTEX_AUTH_MODE=oauth
# Public HTTPS URL clients use to reach this server. Sets the OAuth audience
# and the MCP resource_url, so it must match exactly (no trailing slash).
#VORTEX_PUBLIC_URL=https://vortex.example.com
# Host/Origin are matched exactly including the port, or via a :* wildcard.
#VORTEX_ALLOWED_HOSTS=vortex.example.com
#VORTEX_ALLOWED_ORIGINS=https://vortex.example.com
#VORTEX_OAUTH_ISSUER=https://id.example.com/realms/vortex
#VORTEX_OAUTH_INTROSPECTION_URL=https://id.example.com/realms/vortex/protocol/openid-connect/token/introspect
#VORTEX_OAUTH_CLIENT_ID=vortex-introspection
#VORTEX_OAUTH_CLIENT_SECRET=
# Keycloak client id per Vortex identity (token's client becomes the identity).
#VORTEX_SUBJECT_HERMES_1=hermes-1
#VORTEX_SUBJECT_HERMES_2=hermes-2
#VORTEX_SUBJECT_ANTIGRAVITY_1=antigravity-1
#VORTEX_SUBJECT_SPARK_1=spark-1
# Optional PEM bundle for an internal/Tailscale-signed provider certificate.
#VORTEX_OAUTH_CA_BUNDLE=/path/to/ca.pem
